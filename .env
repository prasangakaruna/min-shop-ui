# Mint E-commerce API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.mint-shop.pro/api

# NextAuth (admin panel). AUTH_SECRET is REQUIRED — without it /api/auth/session returns 500.
# Generate one: openssl rand -base64 32
AUTH_SECRET=Iad9/rZEcgzHMdKS3UkSNMxMTr1nWm2+g5E6HEF4iV0=
# Keycloak (match Mint e-commerce-api docs: client e.g. mint-ecommerce)
KEYCLOAK_CLIENT_ID=mint-ecommerce
KEYCLOAK_CLIENT_SECRET=N8AaDBNoen6QkvV3UxAuvxMIyBe7bRoO
KEYCLOAK_ISSUER=https://auth.mint-market.live/realms/mint

NEXT_PUBLIC_MINT_ROOT_DOMAIN=mint-shop.pro
# Optional: lock browser-side NextAuth/callbackUrl origin (use if users can hit :3000 in the URL bar).
# NEXT_PUBLIC_SITE_URL=https://mint-shop.pro

AUTH_KEYCLOAK_REDIRECT_ORIGIN=https://mint-shop.pro
AUTH_COOKIE_DOMAIN=.mint-shop.pro

AUTH_TRUST_HOST=true